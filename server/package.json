{
  "name": "ai-special-education-thesis-server",
  "version": "1.0.0",
  "description": "Express.js backend for AI Special Education Thesis",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon --watch '*.ts' --watch 'routes/**/*.ts' --watch 'config/**/*.ts' --watch 'middleware/**/*.ts' --watch 'lib/**/*.ts' --exec ts-node server.ts",
    "build": "prisma generate && prisma migrate deploy && tsc && npm run seed:problems",
    "build:prod": "prisma generate && prisma migrate deploy && tsc && npm run seed:problems",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:problems": "ts-node scripts/seed-problems.ts",
    "seed:problems:prod": "NODE_ENV=production ts-node scripts/seed-problems.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^0.3.66",
    "@langchain/openai": "^0.6.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "openai": "^5.10.2",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "prisma": "^7.5.0",
    "uuid": "^11.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.3",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.14",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
